    "canonical_food_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
